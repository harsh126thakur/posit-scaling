# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# --- generated results ---
# CSVs are regenerated by `make all` in well under two minutes, so they are
# not tracked. Drop the next line if you want archival results in the repo.
results/*.csv

# --- generated figures ---
# Figures ARE tracked: the paper needs them and they are small.
# (no ignore rule for paper/figures/)

# --- LaTeX build artifacts ---
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.fdb_latexmk
paper/*.fls
paper/*.toc
# main.pdf IS tracked so readers can see the manuscript without a TeX install.

# --- editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
